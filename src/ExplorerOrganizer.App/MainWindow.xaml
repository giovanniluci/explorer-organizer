<Window x:Class="ExplorerOrganizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorer Organizer" Width="450" Height="660" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="MainWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="/Assets/app.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Explorer Organizer" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"
                        ToolTip="{DynamicResource S.Title.Minimize}" AutomationProperties.Name="{DynamicResource S.Title.Minimize}" AutomationProperties.AutomationId="MinimizeButton" />
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="{DynamicResource S.Title.Close}" AutomationProperties.Name="{DynamicResource S.Title.Close}" AutomationProperties.AutomationId="CloseButton" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <DockPanel Margin="0,4,0,8">
                <ListBox x:Name="NavBottom" DockPanel.Dock="Bottom" Style="{StaticResource RailList}" ItemContainerStyle="{StaticResource RailItem}"
                         SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="{DynamicResource S.Main.NavigationMore}" AutomationProperties.AutomationId="NavBottom">
                    <ListBoxItem Tag="restore" AutomationProperties.Name="{DynamicResource S.Nav.Restore}" AutomationProperties.AutomationId="Nav_restore">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE7A7;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Restore}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" AutomationProperties.Name="{DynamicResource S.Nav.Settings}" AutomationProperties.AutomationId="Nav_settings">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE713;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Settings}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="feedback" AutomationProperties.Name="{DynamicResource S.Nav.Feedback}" AutomationProperties.AutomationId="Nav_feedback">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xED15;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Feedback}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <ListBox x:Name="NavTop" Style="{StaticResource RailList}" ItemContainerStyle="{StaticResource RailItem}"
                         SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="{DynamicResource S.Main.Navigation}" AutomationProperties.AutomationId="NavTop">
                    <ListBoxItem Tag="home" AutomationProperties.Name="{DynamicResource S.Nav.Home}" AutomationProperties.AutomationId="Nav_home">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE80F;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Home}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="rules" AutomationProperties.Name="{DynamicResource S.Nav.Rules}" AutomationProperties.AutomationId="Nav_rules">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE71C;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Rules}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="folders" AutomationProperties.Name="{DynamicResource S.Nav.Folders}" AutomationProperties.AutomationId="Nav_folders">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE8B7;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Folders}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="history" AutomationProperties.Name="{DynamicResource S.Nav.History}" AutomationProperties.AutomationId="Nav_history">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE81C;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.History}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="toolbox" AutomationProperties.Name="{DynamicResource S.Nav.Toolbox}" AutomationProperties.AutomationId="Nav_toolbox">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE821;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="{DynamicResource S.Nav.Toolbox}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <ContentControl x:Name="Page" Grid.Column="1" Focusable="False" AutomationProperties.AutomationId="PageHost" />

            <Border x:Name="BusyOverlay" Grid.Column="1" Background="#55000000" Visibility="Collapsed">
                <ContentControl Style="{StaticResource CardHost}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,12,0" Foreground="{DynamicResource Accent}" />
                        <TextBlock Text="{DynamicResource S.Main.Working}" />
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
