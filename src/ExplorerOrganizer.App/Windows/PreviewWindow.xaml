<Window x:Class="ExplorerOrganizer.App.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Preview.Title}" Width="1240" Height="660" MinWidth="860" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profiles sidebar: the preview and "Apply" work on the selected profile only -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,20">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.Preview.Profiles}" Style="{StaticResource H2}" Margin="6,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.Preview.ProfilesHint}" Style="{StaticResource Muted}" FontSize="12.5"
                           TextWrapping="Wrap" Margin="6,0,0,10" />
                <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" AutomationProperties.Name="{DynamicResource S.Preview.Profiles}"
                         AutomationProperties.AutomationId="PreviewProfiles">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding Name}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="24,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource S.Preview.Heading}" Style="{StaticResource H1}" />
                <TextBlock x:Name="Summary" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.AutomationId="PreviewSummary" />
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource S.Preview.SelectAll}" Click="SelectAll_Click" />
                    <Button Content="{DynamicResource S.Preview.SelectNone}" Click="SelectNone_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource S.Common.Cancel}" IsCancel="True" />
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Margin="0" MinWidth="140" />
                </StackPanel>
            </Grid>

            <Grid>
                <DataGrid x:Name="RecordsGrid" AutomationProperties.Name="{DynamicResource S.Preview.Title}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                              Click="Check_Click" AutomationProperties.Name="{DynamicResource S.Preview.Include}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource S.Col.Status}" Width="110" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumText}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource S.Col.Action}" Width="170" SortMemberPath="Kind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource EnumText}}" VerticalAlignment="Center" />
                                        <Border x:Name="FolderTag" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="Collapsed" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource S.Preview.Folder}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter TargetName="FolderTag" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource S.Col.Source}" Binding="{Binding Source}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource S.Col.Target}" Binding="{Binding Target}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource S.Col.Rule}" Binding="{Binding RuleName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource S.Col.Message}" Binding="{Binding Message}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="Empty" Text="{DynamicResource S.Preview.Empty}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" Visibility="Collapsed" />
                <StackPanel x:Name="Loading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{DynamicResource Accent}" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource S.Main.Working}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
