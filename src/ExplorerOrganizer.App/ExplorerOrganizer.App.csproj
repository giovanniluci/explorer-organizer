<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExplorerOrganizer.App</RootNamespace>
    <AssemblyName>ExplorerOrganizer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- WinForms is used only for the tray icon: keep its namespaces out of the global usings to avoid WPF name clashes. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExplorerOrganizer.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExplorerOrganizer.Core\ExplorerOrganizer.Core.csproj" />
  </ItemGroup>

</Project>
