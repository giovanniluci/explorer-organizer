<UserControl x:Class="ExplorerOrganizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:ExplorerOrganizer.App.Infrastructure"
             AutomationProperties.AutomationId="Page_settings">
    <ScrollViewer Style="{StaticResource ScrollPage}">
        <StackPanel Margin="4,4,14,14">
            <TextBlock Text="{DynamicResource S.Settings.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource S.Settings.Subtitle}" Style="{StaticResource Caption}" Margin="0,0,0,12" />

            <!-- Appearance -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Settings.Appearance}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <Label Content="{DynamicResource S.Settings.Language}" Target="{Binding ElementName=LanguageBox}" />
                    <ComboBox x:Name="LanguageBox" ItemsSource="{x:Static inf:EnumOptions.Languages}" SelectedValuePath="Value" DisplayMemberPath="Display"
                              SelectedValue="{Binding Language}" AutomationProperties.AutomationId="LanguageBox" />
                    <Label Content="{DynamicResource S.Settings.Theme}" Target="{Binding ElementName=ThemeBox}" Margin="0,10,0,0" />
                    <ComboBox x:Name="ThemeBox" ItemsSource="{x:Static inf:EnumOptions.Themes}" SelectedValuePath="Value" DisplayMemberPath="Display"
                              SelectedValue="{Binding Theme}" AutomationProperties.AutomationId="ThemeBox" />
                    <TextBlock Text="{DynamicResource S.Settings.HighContrastHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </ContentControl>

            <!-- Safety -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Settings.Safety}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PreviewBeforeApply}">
                        <TextBlock Text="{DynamicResource S.Settings.PreviewBeforeApply}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SimulationMode}" AutomationProperties.AutomationId="SimulationSwitch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Settings.SimulationMode}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource S.Settings.SimulationHint}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <Label Content="{DynamicResource S.Settings.Stability}" Target="{Binding ElementName=StabilityBox}" Margin="0,8,0,0" />
                    <TextBox x:Name="StabilityBox" Text="{Binding StabilitySeconds}" Width="90" HorizontalAlignment="Left" />
                    <Label Content="{DynamicResource S.Settings.Ignore}" Target="{Binding ElementName=IgnoreBox}" Margin="0,10,0,0" />
                    <TextBox x:Name="IgnoreBox" Text="{Binding IgnorePatterns}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource S.Settings.IgnoreHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </ContentControl>

            <!-- Background -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Settings.Background}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.AutomationId="AutostartSwitch">
                        <TextBlock Text="{DynamicResource S.Settings.StartWithWindows}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}">
                        <TextBlock Text="{DynamicResource S.Settings.StartMinimized}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowNotifications}">
                        <TextBlock Text="{DynamicResource S.Settings.Notifications}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowDropTarget}">
                        <TextBlock Text="{DynamicResource S.Settings.ShowDropTarget}" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </ContentControl>

            <!-- Explorer -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Settings.Explorer}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock x:Name="ContextMenuStatus" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="{DynamicResource S.Settings.AddContextMenu}" Click="AddContextMenu_Click" Margin="0,0,8,6" />
                        <Button Content="{DynamicResource S.Settings.RemoveContextMenu}" Click="RemoveContextMenu_Click" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource S.Settings.ContextMenuHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </ContentControl>

            <!-- Data -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Settings.Data}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="{DynamicResource S.Settings.OpenData}" Click="OpenData_Click" Margin="0,0,8,6" />
                        <Button Content="{DynamicResource S.Settings.RunWizard}" Click="Wizard_Click" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
