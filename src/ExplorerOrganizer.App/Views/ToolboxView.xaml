<UserControl x:Class="ExplorerOrganizer.App.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page_toolbox">
    <ScrollViewer Style="{StaticResource ScrollPage}">
        <StackPanel Margin="4,4,14,14">
            <TextBlock Text="{DynamicResource S.Toolbox.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource S.Toolbox.Subtitle}" Style="{StaticResource Caption}" Margin="0,0,0,12" />

            <!-- Profiles -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="18" />
                        <TextBlock Text="{DynamicResource S.Toolbox.Profiles}" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <Label Content="{DynamicResource S.Dash.ActiveProfile}" Target="{Binding ElementName=ProfileCombo}" />
                    <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" SelectionChanged="ProfileCombo_SelectionChanged"
                              AutomationProperties.Name="{DynamicResource S.Dash.ActiveProfile}" AutomationProperties.AutomationId="ToolboxProfileCombo" />
                    <Label Content="{DynamicResource S.Profiles.Name}" Target="{Binding ElementName=NameBox}" Margin="0,10,0,0" />
                    <TextBox x:Name="NameBox" LostFocus="NameBox_LostFocus" AutomationProperties.Name="{DynamicResource S.Profiles.Name}" />
                    <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" Click="Enabled_Click" Margin="0,10,0,4"
                              AutomationProperties.Name="{DynamicResource S.Toolbox.ProfileEnabled}">
                        <TextBlock Text="{DynamicResource S.Toolbox.ProfileEnabled}" TextWrapping="Wrap" />
                    </CheckBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Click="NewProfile_Click" Margin="0,0,8,6" AutomationProperties.AutomationId="NewProfileButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Toolbox.New}" />
                            </StackPanel>
                        </Button>
                        <Button Click="DuplicateProfile_Click" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Common.Duplicate}" />
                            </StackPanel>
                        </Button>
                        <Button Click="DeleteProfile_Click" Margin="0,0,8,6" Foreground="{DynamicResource Danger}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Common.Delete}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ContentControl>

            <!-- Presets -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7C4;" FontSize="18" />
                        <TextBlock Text="{DynamicResource S.Toolbox.Presets}" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource S.Toolbox.PresetsHint}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="PresetList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource S.Toolbox.Add}" Tag="{Binding Kind}" Click="AddPreset_Click" Margin="8,0,0,0"
                                            VerticalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Import / export -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="18" />
                        <TextBlock Text="{DynamicResource S.Toolbox.ImportExport}" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource S.Toolbox.ImportExportHint}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Click="Import_Click" Margin="0,0,8,6" AutomationProperties.AutomationId="ImportButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Toolbox.Import}" />
                            </StackPanel>
                        </Button>
                        <Button Click="Export_Click" Margin="0,0,8,6" AutomationProperties.AutomationId="ExportButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Toolbox.Export}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ContentControl>

            <!-- Drop target -->
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <CheckBox x:Name="DropTargetSwitch" Style="{StaticResource Switch}" Click="DropTarget_Click" Margin="0" AutomationProperties.AutomationId="DropTargetSwitch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Tray.DropTarget}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource S.Toolbox.DropTargetHint}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
