<UserControl x:Class="ExplorerOrganizer.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page_restore">
    <DockPanel Margin="4,4,14,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource S.Restore.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource S.Restore.Subtitle}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
            <ContentControl Style="{StaticResource CardHost}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="18" />
                        <TextBlock Text="{DynamicResource S.Home.CardHistoryLabel}" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="LastText" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <Button x:Name="UndoButton" Style="{StaticResource HeroButton}" Click="Undo_Click" Content="{DynamicResource S.Restore.UndoLast}"
                            AutomationProperties.AutomationId="UndoLastButton" />
                </StackPanel>
            </ContentControl>
            <TextBlock Text="{DynamicResource S.Restore.Journal}" FontWeight="SemiBold" Margin="2,4,0,8" />
        </StackPanel>

        <Grid>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource S.Restore.Empty}" Style="{StaticResource Caption}" Margin="4,0" Visibility="Collapsed" />
            <ListBox x:Name="BatchList" ItemContainerStyle="{StaticResource CardItem}" AutomationProperties.Name="{DynamicResource S.Restore.Journal}"
                     AutomationProperties.AutomationId="BatchList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
